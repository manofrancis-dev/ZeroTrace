# Copy to backend/.env and replace every placeholder with a long random value.
ZERO_TRACE_API_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
MAX_URL_LENGTH=2048
HTTP_TIMEOUT_SECONDS=12
RATE_LIMIT_PER_MINUTE=20

# VirusTotal
VT_API_KEY=
VT_SUBMIT_NEW=true
VT_REANALYZE=true
VT_POLL_SECONDS=10
VT_MAX_POLLS=2

# RDAP and dynamic sandbox
RDAP_ENABLED=true
SANDBOX_ENABLED=true
SANDBOX_API_URL=http://sandbox:8001
SANDBOX_API_KEY=replace-with-another-random-secret
SANDBOX_TIMEOUT_SECONDS=60

# Browser session cookies
BROWSER_SESSION_MAX_AGE=900
COOKIE_SECURE=false
BROWSER_SESSION_SAMESITE=lax
